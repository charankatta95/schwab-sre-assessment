      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "ffz1nv8ui1ypsb"
                      },
                      "group": "grafana-bigquery-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "location": "",
                        "project": "schwab-sre-assessment",
                        "rawQuery": true,
                        "rawSql": "WITH combined AS (\n  SELECT timestamp, resource.labels.namespace_name AS namespace, 'stderr' AS stream\n  FROM `schwab-sre-assessment.gke_logs.stderr_*`\n  WHERE _TABLE_SUFFIX = FORMAT_DATE('%Y%m%d', CURRENT_DATE())\n    AND resource.labels.namespace_name IN ('app-primary', 'app-secondary')\n  UNION ALL\n  SELECT timestamp, resource.labels.namespace_name AS namespace, 'stdout' AS stream\n  FROM `schwab-sre-assessment.gke_logs.stdout_*`\n  WHERE _TABLE_SUFFIX = FORMAT_DATE('%Y%m%d', CURRENT_DATE())\n    AND resource.labels.namespace_name IN ('app-primary', 'app-secondary')\n)\nSELECT\n  TIMESTAMP_TRUNC(timestamp, MINUTE) AS bucket,\n  namespace,\n  COUNTIF(stream = 'stderr') AS error_count,\n  COUNT(*) AS total_count,\n  SAFE_DIVIDE(COUNTIF(stream = 'stderr'), COUNT(*)) AS error_rate\nFROM combined\nGROUP BY bucket, namespace\nORDER BY bucket ASC",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 1,
          "links": [],
          "title": "Application Error Rate(stderr ratio)",
