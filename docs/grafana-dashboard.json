                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "location": "",
                        "project": "schwab-sre-assessment",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  jsonPayload.involvedobject.namespace AS namespace,\n  jsonPayload.involvedobject.name AS obj_name,\n  jsonPayload.reason AS reason,\n  COUNT(*) AS event_count\nFROM `schwab-sre-assessment.gke_logs.events_*`\nWHERE _TABLE_SUFFIX = FORMAT_DATE('%Y%m%d', CURRENT_DATE())\n  AND jsonPayload.reason IN ('SuccessfulCreate', 'SuccessfulDelete', 'FailedCreate', 'BackOff', 'ScaleUpFailed')\nGROUP BY namespace, obj_name, reason\nORDER BY event_count DESC",
                        "sql": {
